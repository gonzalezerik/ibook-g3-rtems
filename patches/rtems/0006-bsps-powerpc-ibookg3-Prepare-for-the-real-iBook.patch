+ * AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
+ * IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
+ * ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE
+ * LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+ * POSSIBILITY OF SUCH DAMAGE.
+ */
+
+/*
+ * The real iBook has no external serial port, so console output is also
+ * drawn on the screen. Open Firmware leaves the display mode it used for
+ * its own console; this draws 8x16 characters into that frame buffer, white
+ * on black, and scrolls. It writes only; console input stays on the ESCC.
+ */
+
+#include <bsp.h>
+
+#include <string.h>
+
+#include "font_data.h"
+
+static volatile uint8_t *fb;
+static uint32_t bytes_per_pixel;
+static uint32_t stride;
+static uint32_t columns;
+static uint32_t rows;
+static uint32_t height;
+static uint32_t column;
+static uint32_t row;
+static uint32_t fg;
+static uint32_t bg;
+
+static void put_pixel(volatile uint8_t *p, uint32_t color)
+{
+  switch (bytes_per_pixel) {
+    case 1:
+      *p = (uint8_t) color;
+      break;
+    case 2:
+      *(volatile uint16_t *) p = (uint16_t) color;
+      break;
+    case 3:
+      p[0] = (uint8_t) (color >> 16);
+      p[1] = (uint8_t) (color >> 8);
+      p[2] = (uint8_t) color;
+      break;
+    default:
+      *(volatile uint32_t *) p = color;
+      break;
+  }
+}
+
+static void fill_rows(uint32_t first_pixel_row, uint32_t count)
+{
+  for (uint32_t y = first_pixel_row; y < first_pixel_row + count; ++y) {
+    volatile uint8_t *p = fb + y * stride;
+
+    for (uint32_t x = 0; x < columns * IBOOKG3_FONT_WIDTH; ++x) {
+      put_pixel(p, bg);
+      p += bytes_per_pixel;
+    }
+  }
+}
+
+static void draw_char(uint32_t r, uint32_t c, unsigned char ch)
+{
+  const unsigned char *glyph = &ibookg3_font[ch * IBOOKG3_FONT_HEIGHT];
+  volatile uint8_t *line = fb + r * IBOOKG3_FONT_HEIGHT * stride +
+    c * IBOOKG3_FONT_WIDTH * bytes_per_pixel;
+
+  for (uint32_t y = 0; y < IBOOKG3_FONT_HEIGHT; ++y) {
+    volatile uint8_t *p = line;
+    unsigned char bits = glyph[y];
+
+    for (uint32_t x = 0; x < IBOOKG3_FONT_WIDTH; ++x) {
+      put_pixel(p, (bits & 0x80) != 0 ? fg : bg);
+      bits <<= 1;
+      p += bytes_per_pixel;
+    }
+
+    line += stride;
+  }
+}
+
+static void scroll(void)
+{
+  uint32_t text_line = IBOOKG3_FONT_HEIGHT * stride;
+
+  for (uint32_t i = 0; i < (rows - 1) * text_line; i += 4) {
+    *(volatile uint32_t *) (fb + i) = *(volatile uint32_t *) (fb + i + text_line);
+  }
+
+  fill_rows((rows - 1) * IBOOKG3_FONT_HEIGHT, IBOOKG3_FONT_HEIGHT);
+}
+
+static void new_line(void)
+{
+  column = 0;
+
+  if (row + 1 < rows) {
+    ++row;
+  } else {
+    scroll();
+  }
+}
+
+void ibookg3_fbcons_output(char c)
+{
+  if (fb == NULL) {
+    return;
+  }
+
+  switch (c) {
+    case '\r':
+      column = 0;
+      break;
+    case '\n':
+      new_line();
+      break;
+    case '\b':
+      if (column > 0) {
+        --column;
+      }
+      break;
+    case '\t':
+      column = (column + 8) & ~7U;
+      if (column >= columns) {
+        new_line();
+      }
+      break;
+    default:
+      if (column >= columns) {
+        new_line();
+      }
+      draw_char(row, column, (unsigned char) c);
+      ++column;
+      break;
+  }
+}
+
+void ibookg3_fbcons_initialize(void)
+{
+  const ibookg3_framebuffer *f = &ibookg3_fb;
+
+  if (f->base == 0 || f->width < IBOOKG3_FONT_WIDTH ||
+      f->height < IBOOKG3_FONT_HEIGHT) {
+    return;
+  }
+
+  switch (f->depth) {
+    case 8:
+      /* Palette entries set in ofw_probe_display() */
+      fg = 15;
+      bg = 0;
+      break;
+    case 15:
+    case 16:
+    case 24:
+    case 32:
+      /* White in any direct color format */
+      fg = f->depth >= 24 ? 0x00ffffff : (f->depth == 16 ? 0xffff : 0x7fff);
+      bg = 0;
+      break;
+    default:
+      return;
+  }
+
+  bytes_per_pixel = (f->depth + 7) / 8;
+  stride = f->stride;
+  columns = f->width / IBOOKG3_FONT_WIDTH;
+  rows = f->height / IBOOKG3_FONT_HEIGHT;
+  height = f->height;
+  column = 0;
+  row = 0;
+  fb = (volatile uint8_t *) f->base;
+
+  /* Stride is a multiple of 4 on all Apple displays; scroll() relies on it */
+  if ((stride & 3) != 0) {
+    fb = NULL;
+    return;
+  }
+
+  fill_rows(0, height);
+}
