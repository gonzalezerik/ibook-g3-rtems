 bsps/powerpc/ibookg3/console/fbcons.c         |  211 +
 bsps/powerpc/ibookg3/console/font_data.h      | 4639 +++++++++++++++++
 bsps/powerpc/ibookg3/include/bsp.h            |   24 +
 bsps/powerpc/ibookg3/irq/irq.c                |   28 +-
