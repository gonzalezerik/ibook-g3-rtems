diff --git a/bsps/powerpc/ibookg3/console/console-escc.c b/bsps/powerpc/ibookg3/console/console-escc.c
index d79e379c9d2..654cca771a7 100644
--- a/bsps/powerpc/ibookg3/console/console-escc.c
+++ b/bsps/powerpc/ibookg3/console/console-escc.c
@@ -73,6 +73,9 @@ void console_outbyte_polled(int port, char ch)
 
   *escc_reg(IBOOKG3_MACIO_ESCC_CHA_DATA) = (uint8_t) ch;
   __asm__ volatile ("eieio");
+
+  /* Also on the screen; the real iBook has no external serial port */
+  ibookg3_fbcons_output(ch);
 }
 
 int console_inbyte_nonblocking(int port)
