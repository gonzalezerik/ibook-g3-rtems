new file mode 100644
index 00000000000..802be49cbbf
--- /dev/null
+++ b/bsps/powerpc/ibookg3/console/fbcons.c
@@ -0,0 +1,211 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+
+/**
+ * @file
+ *
+ * @ingroup RTEMSBSPsPowerPCiBookG3
+ *
+ * @brief Text console on the frame buffer Open Firmware set up.
+ */
+
+/*
