 bsps/powerpc/ibookg3/start/linkcmds           |    6 +-
 bsps/powerpc/ibookg3/start/ofw.c              |  280 +-
 .../build/bsps/powerpc/ibookg3/bspibookg3.yml |    1 +
 9 files changed, 5177 insertions(+), 41 deletions(-)
