 void ibookg3_ofw_probe(void *ofw_entry)
 {
   phandle node;
@@ -185,9 +228,60 @@ void ibookg3_ofw_probe(void *ofw_entry)
   /* assigned-addresses: phys.hi, phys.mid, phys.lo, size.hi, size.lo */
   node = ofw_find_by_name(ofw_peer(0), "mac-io");
   if (node != 0) {
+    phandle child;
+
     len = ofw_getprop(node, "assigned-addresses", reg, sizeof(reg));
     if (len >= 5 * 4) {
       ibookg3_macio_base = reg[2];
     }
+
+    /*
+     * The ATA controllers are children of the mac-io node. Their reg is
+     * (offset, size) relative to the mac-io window, the interrupts
+     * property is an OpenPIC source number and sense, and AAPL,bus-id
+     * says which of the two IDE buses it is.
+     */
+    for (child = ofw_child(node); child != 0 && child != -1;
+      child = ofw_peer(child)) {
+      char name[16];
+      int32_t name_len = ofw_getprop(child, "name", name, sizeof(name) - 1);
+      uint32_t bus_id;
+
+      if (name_len != 5 || memcmp(name, "ata-3", 5) != 0) {
+        continue;
+      }
+
+      bus_id = IBOOKG3_ATA_COUNT;
+      ofw_get_u32(child, "AAPL,bus-id", &bus_id);
+      if (bus_id >= IBOOKG3_ATA_COUNT) {
+        continue;
+      }
+
+      len = ofw_getprop(child, "reg", reg, 2 * sizeof(reg[0]));
+      if (len == 2 * (int32_t) sizeof(reg[0])) {
+        ibookg3_ata_base[bus_id] = ibookg3_macio_base + reg[0];
+      }
+
+      len = ofw_getprop(child, "interrupts", reg, sizeof(reg[0]));
+      if (len == (int32_t) sizeof(reg[0])) {
+        ibookg3_ata_irq[bus_id] = reg[0];
+      }
+    }
+  }
+
+  /*
+   * UniNorth PCI host bridge. The /pci alias names the main bus on
+   * NewWorld machines; its reg is the base of the bridge register space
+   * and the configuration address and data windows live at fixed offsets
+   * from it.
+   */
+  node = ofw_finddevice("/pci");
+  if (node != -1) {
+    len = ofw_getprop(node, "reg", reg, sizeof(reg[0]));
+    if (len == (int32_t) sizeof(reg[0])) {
+      ibookg3_uninorth_base = reg[0];
+    }
+
+    ofw_read_pci_interrupt_map(node);
   }
 }
