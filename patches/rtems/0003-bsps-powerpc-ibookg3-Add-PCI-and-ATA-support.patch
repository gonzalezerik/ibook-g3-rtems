+/*
+ * The interrupt-map property lists (address, pin, parent, specifier)
+ * tuples of seven cells each. Only the main bridge matters here: its
+ * address cells carry the device slot, its parent is the OpenPIC and
+ * the specifier holds the source number.
+ */
+static void ofw_read_pci_interrupt_map(phandle node)
+{
+  ibookg3_pci_map_entry_t entries[IBOOKG3_PCI_MAP_MAX];
+  uint32_t map[IBOOKG3_PCI_MAP_MAX * IBOOKG3_PCI_MAP_CELLS];
+  unsigned int count;
+  int32_t len;
+
+  len = ofw_getprop(node, "interrupt-map", map, sizeof(map));
+  if (len <= 0) {
+    return;
+  }
+
+  count = (unsigned int) len / (IBOOKG3_PCI_MAP_CELLS * 4);
+  if (count > IBOOKG3_PCI_MAP_MAX) {
+    count = IBOOKG3_PCI_MAP_MAX;
+  }
+
+  for (unsigned int i = 0; i < count; ++i) {
+    const uint32_t *cell = map + i * IBOOKG3_PCI_MAP_CELLS;
+
+    /* The slot is the device number of the devfn byte of phys.hi */
+    entries[i].slot = (cell[0] >> 11) & 0x1f;
+    entries[i].pin = cell[3];
+    entries[i].vector = cell[5];
+  }
+
+  ibookg3_pci_set_interrupt_map(entries, count);
+}
