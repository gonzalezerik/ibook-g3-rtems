+++ b/bsps/powerpc/ibookg3/include/bsp.h
@@ -65,15 +65,59 @@ extern uint32_t ibookg3_bus_frequency;
 extern uint32_t ibookg3_cpu_frequency;
 extern uint32_t ibookg3_memory_size;
 extern uintptr_t ibookg3_macio_base;
+extern uintptr_t ibookg3_uninorth_base;
+
+/*
+ * KeyLargo ATA controllers, one per bus (primary, secondary). The base
+ * addresses point at the command block relative to ibookg3_macio_base and
+ * the interrupt numbers are KeyLargo OpenPIC sources.
+ */
+#define IBOOKG3_ATA_COUNT 2
+extern uintptr_t ibookg3_ata_base[IBOOKG3_ATA_COUNT];
+extern uint32_t ibookg3_ata_irq[IBOOKG3_ATA_COUNT];
 
 /* KeyLargo (mac-io) register blocks, offsets from ibookg3_macio_base */
 #define IBOOKG3_MACIO_ESCC_CHA_CTRL 0x13020
 #define IBOOKG3_MACIO_ESCC_CHA_DATA 0x13030
 #define IBOOKG3_MACIO_OPENPIC 0x40000
+#define IBOOKG3_MACIO_ATA0 0x20000
+#define IBOOKG3_MACIO_ATA1 0x21000
+
+/*
+ * UniNorth PCI host bridge register blocks, offsets from
+ * ibookg3_uninorth_base.  The config address and data windows are each
+ * 4KiB.
+ */
+#define IBOOKG3_UNINORTH_CFG_ADDR 0x800000
+#define IBOOKG3_UNINORTH_CFG_DATA 0xc00000
 
 /* Used if Open Firmware does not provide the value */
 #define IBOOKG3_MACIO_BASE_DEFAULT 0x80000000
 #define IBOOKG3_MEMORY_SIZE_DEFAULT 0x08000000
+#define IBOOKG3_UNINORTH_BASE_DEFAULT 0xf2000000
+#define IBOOKG3_ATA_IRQ_DEFAULT 13
+
+/*
+ * One interrupt-map entry as published under /pci. The bridge maps a
+ * slot and pin to an OpenPIC source; seven device tree cells describe
+ * the address (three), the pin, the parent phandle and the OpenPIC
+ * specifier (source and sense).
+ */
+typedef struct {
+  uint32_t slot;   /* device slot from the address part of the map */
+  uint32_t pin;    /* interrupt pin, 1 = A */
+  uint32_t vector; /* OpenPIC source from the interrupt specifier */
+} ibookg3_pci_map_entry_t;
+
+#define IBOOKG3_PCI_MAP_MAX 16
+#define IBOOKG3_PCI_MAP_CELLS 7
+
+void ibookg3_pci_set_interrupt_map(
+  const ibookg3_pci_map_entry_t *entries,
+  unsigned int count
+);
+
+int ibookg3_pci_route_irq(int bus, int slot, int pin);
 
 /* Called from start.S while Open Firmware is still in control */
 void ibookg3_ofw_probe(void *ofw_entry);
diff --git a/bsps/powerpc/ibookg3/pci/pci.c b/bsps/powerpc/ibookg3/pci/pci.c
new file mode 100644
index 00000000000..e7f07169055
--- /dev/null
+++ b/bsps/powerpc/ibookg3/pci/pci.c
@@ -0,0 +1,303 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+
+/**
+ * @file
+ *
+ * @ingroup RTEMSBSPsPowerPCiBookG3
+ *
+ * @brief UniNorth PCI host bridge configuration space access.
+ *
+ * The UniNorth bridges use a memory-mapped configuration mechanism instead
+ * of the Intel CF8/CFC ports. A 4KiB address register window and a 4KiB
+ * data window sit at fixed offsets from the bridge base, which the
+ * /pci device tree node's reg property provides. Bus zero selects devices
+ * with a one-hot slot bit (CFA0); other buses use an encoding close to the
+ * x86 one with a tag bit (CFA1). The address write must be verified by
+ * reading it back: the bridge latches slowly and returns garbage otherwise.
+ */
+
+/*
+ * Copyright (C) 2026 Erik Gonzalez
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
+ * 1. Redistributions of source code must retain the above copyright
+ *    notice, this list of conditions and the following disclaimer.
+ * 2. Redistributions in binary form must reproduce the above copyright
+ *    notice, this list of conditions and the following disclaimer in the
+ *    documentation and/or other materials provided with the distribution.
+ *
+ * THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS "AS IS"
+ * AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
+ * IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
+ * ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE
+ * LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+ * POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include <bsp.h>
+#include <bsp/irq.h>
+#include <bsp/pci.h>
+
+#include <string.h>
+
+#include <rtems/bspIo.h>
+
+/* Slot 11 holds the UniNorth host bridge itself on bus zero */
+#define UNINORTH_FIRST_DEVICE (11 << 3)
+
+static volatile uint32_t *unin_cfg_addr;
+static volatile uint32_t *unin_cfg_data;
+
+static ibookg3_pci_map_entry_t ibookg3_pci_map[IBOOKG3_PCI_MAP_MAX];
+static unsigned int ibookg3_pci_map_count;
+
+void ibookg3_pci_set_interrupt_map(
+  const ibookg3_pci_map_entry_t *entries,
+  unsigned int count
+)
+{
+  if (count > IBOOKG3_PCI_MAP_MAX) {
+    count = IBOOKG3_PCI_MAP_MAX;
+  }
+
+  memcpy(ibookg3_pci_map, entries, count * sizeof(*entries));
+  ibookg3_pci_map_count = count;
+}
+
+int ibookg3_pci_route_irq(int bus, int slot, int pin)
+{
+  unsigned int i;
+
+  if (pin < 1 || pin > 4) {
+    return -1;
+  }
+
+  for (i = 0; i < ibookg3_pci_map_count; ++i) {
+    if (ibookg3_pci_map[i].slot == (uint32_t) slot &&
+        ibookg3_pci_map[i].pin == (uint32_t) pin) {
+      return (int) ibookg3_pci_map[i].vector;
+    }
+  }
+
+  /*
+   * Pins without an entry in the published map follow the wiring of the
+   * KeyLargo: the four interrupt inputs of the main UniNorth bridge are
+   * OpenPIC sources 27 to 30 and a device rotates through them.
+   */
+  if (bus != 0) {
+    return -1;
+  }
+
+  return 27 + (((pin - 1) + slot) & 3);
+}
+
+/* Build the value for the configuration address register */
+static uint32_t unin_config_reg(
+  unsigned char bus,
+  unsigned char slot,
+  unsigned char function,
+  unsigned char where
+)
+{
+  if (bus == 0) {
+    return (1U << slot) | (function << 8) | (where & 0xfcU);
+  }
+
+  return (bus << 16) | (PCI_DEVFN(slot, function) << 8) | (where & 0xfcU)
+    | 1U;
+}
+
+/*
+ * The bridge windows are little endian; the CPU accesses them with the
+ * byte-reversing loads and stores so that register values land in the
+ * usual PCI byte order.
+ */
+static void unin_set_addr(uint32_t caddr)
+{
+  out_le32(unin_cfg_addr, caddr);
+  while (in_le32(unin_cfg_addr) != caddr) {
+    /* Keep poking until the bridge latches the value */
+  }
+}
+
+static int unin_read(
+  unsigned char bus,
+  unsigned char slot,
+  unsigned char function,
+  unsigned char where,
+  void *val,
+  unsigned int size
+)
+{
+  volatile const uint8_t *data;
+  rtems_interrupt_level level;
+  uint32_t caddr;
+
+  /* Devices on bus zero start at the host bridge in slot 11 */
+  if (bus == 0 && slot < (UNINORTH_FIRST_DEVICE >> 3)) {
+    memset(val, 0xff, size);
+    return PCIB_ERR_SUCCESS;
+  }
+
+  caddr = unin_config_reg(bus, slot, function, where);
+  data = (const volatile uint8_t *) unin_cfg_data + (where & 7U);
+
+  rtems_interrupt_disable(level);
+  unin_set_addr(caddr);
+  switch (size) {
+    case 1:
+      *(uint8_t *) val = in_8(data);
+      break;
+    case 2:
+      *(uint16_t *) val = in_le16((const volatile uint16_t *) data);
+      break;
+    default:
+      *(uint32_t *) val = in_le32((const volatile uint32_t *) data);
+      break;
+  }
+  rtems_interrupt_enable(level);
+
+  return PCIB_ERR_SUCCESS;
+}
+
+static int unin_write(
+  unsigned char bus,
+  unsigned char slot,
+  unsigned char function,
+  unsigned char where,
+  const void *val,
+  unsigned int size
+)
+{
+  volatile uint8_t *data;
+  rtems_interrupt_level level;
+  uint32_t caddr;
+
+  if (bus == 0 && (PCI_DEVFN(slot, function) < UNINORTH_FIRST_DEVICE)) {
+    return PCIB_ERR_NOTPRESENT;
+  }
+
+  caddr = unin_config_reg(bus, slot, function, where);
+  data = (volatile uint8_t *) unin_cfg_data + (where & 7U);
+
+  rtems_interrupt_disable(level);
+  unin_set_addr(caddr);
+  switch (size) {
+    case 1:
+      out_8(data, *(const uint8_t *) val);
+      break;
+    case 2:
+      out_le16((volatile uint16_t *) data, *(const uint16_t *) val);
+      break;
+    default:
+      out_le32((volatile uint32_t *) data, *(const uint32_t *) val);
+      break;
+  }
+  rtems_interrupt_enable(level);
+
+  return PCIB_ERR_SUCCESS;
+}
+
+static int ibookg3_read_config_byte(
+  unsigned char bus, unsigned char slot, unsigned char function,
+  unsigned char where, uint8_t *val
+)
+{
+  return unin_read(bus, slot, function, where, val, 1);
+}
+
+static int ibookg3_read_config_word(
+  unsigned char bus, unsigned char slot, unsigned char function,
+  unsigned char where, uint16_t *val
+)
+{
+  return unin_read(bus, slot, function, where, val, 2);
+}
+
+static int ibookg3_read_config_dword(
+  unsigned char bus, unsigned char slot, unsigned char function,
+  unsigned char where, uint32_t *val
+)
+{
+  return unin_read(bus, slot, function, where, val, 4);
+}
+
+static int ibookg3_write_config_byte(
+  unsigned char bus, unsigned char slot, unsigned char function,
+  unsigned char where, uint8_t val
+)
+{
+  return unin_write(bus, slot, function, where, &val, 1);
+}
+
+static int ibookg3_write_config_word(
+  unsigned char bus, unsigned char slot, unsigned char function,
+  unsigned char where, uint16_t val
+)
+{
+  return unin_write(bus, slot, function, where, &val, 2);
+}
+
+static int ibookg3_write_config_dword(
+  unsigned char bus, unsigned char slot, unsigned char function,
+  unsigned char where, uint32_t val
+)
+{
+  return unin_write(bus, slot, function, where, &val, 4);
+}
+
+static const pci_config_access_functions ibookg3_pci_functions = {
+  .read_config_byte = ibookg3_read_config_byte,
+  .read_config_word = ibookg3_read_config_word,
+  .read_config_dword = ibookg3_read_config_dword,
+  .write_config_byte = ibookg3_write_config_byte,
+  .write_config_word = ibookg3_write_config_word,
+  .write_config_dword = ibookg3_write_config_dword
+};
+
+rtems_pci_config_t BSP_pci_configuration = {
+  .pci_functions = &ibookg3_pci_functions
+};
+
+/*
+ * Seed each device's interrupt line register with its OpenPIC source so
+ * that drivers only have to read PCI_INTERRUPT_LINE, the way the
+ * powermac firmware does.
+ */
+int pci_initialize(void)
+{
+  unsigned char slot;
+
+  unin_cfg_addr = (volatile uint32_t *)
+    (ibookg3_uninorth_base + IBOOKG3_UNINORTH_CFG_ADDR);
+  unin_cfg_data = (volatile uint32_t *)
+    (ibookg3_uninorth_base + IBOOKG3_UNINORTH_CFG_DATA);
+
+  for (slot = 0; slot < PCI_MAX_DEVICES; ++slot) {
+    uint32_t vendor;
+    uint8_t pin;
+    uint8_t line;
+    int vector;
+
+    if (pci_read_config_dword(0, slot, 0, PCI_VENDOR_ID, &vendor)
+        != PCIB_ERR_SUCCESS || vendor == 0xffffffffU) {
+      continue;
+    }
+
+    pci_read_config_byte(0, slot, 0, PCI_INTERRUPT_PIN, &pin);
+    vector = ibookg3_pci_route_irq(0, slot, pin);
+    if (vector >= 0) {
+      line = (uint8_t) vector;
+      pci_write_config_byte(0, slot, 0, PCI_INTERRUPT_LINE, line);
+    }
+  }
+
+  return PCIB_ERR_SUCCESS;
+}
