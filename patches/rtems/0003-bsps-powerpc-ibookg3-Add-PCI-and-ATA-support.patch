--- /dev/null
+++ b/bsps/powerpc/ibookg3/ata/ide.c
@@ -0,0 +1,300 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+
+/**
+ * @file
+ *
+ * @ingroup RTEMSBSPsPowerPCiBookG3
+ *
+ * @brief KeyLargo ATA controller backend for the shared IDE driver.
+ *
+ * The KeyLargo IDE channels are memory-mapped children of the mac-io
+ * block. Unlike the ISA layout the taskfile registers sit 0x10 bytes
+ * apart, so register index n is at base + 0x10 * n, and the alternate
+ * status and device control register (index 8) sits at base + 0x160.
+ * Only the data register is accessed as words; byte accesses to it are
+ * undefined on this hardware.
+ *
+ * The bridge delivers the registers little endian while the CPU runs
+ * big endian. Plain word loads and stores through the byte-reversing
+ * cache attribute cancel out with the big endian store into the buffer,
+ * leaving the bytes in the same order an x86 host would see, which is
+ * what the shared ATA layer's CF_LE_W() parsing expects. The IDENTIFY
+ * model string is the empirical check of that reasoning.
+ */
+
+/*
+ * Copyright (C) 2026 Erik Gonzalez
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
+ * 1. Redistributions of source code must retain the above copyright
+ *    notice, this list of conditions and the following disclaimer.
+ * 2. Redistributions in binary form must reproduce the above copyright
+ *    notice, this list of conditions and the following disclaimer in the
+ *    documentation and/or other materials provided with the distribution.
+ *
+ * THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS "AS IS"
+ * AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
+ * IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
+ * ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE
+ * LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+ * POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include <bsp.h>
+#include <bsp/irq.h>
+#include <libchip/ide_ctrl.h>
+#include <libchip/ide_ctrl_cfg.h>
+#include <libchip/ide_ctrl_io.h>
+
+#include <rtems/bspIo.h>
+
+/* KeyLargo taskfile register offsets from the channel base */
+#define KEYLARGO_REG(off) ((off) * 0x10)
+#define KEYLARGO_DEVICE_CONTROL 0x160
+
+#define ATA_SECTOR_SIZE (512)
+
+/* Generous busy-wait bound; a reset or seek completes far sooner */
+#define IBOOKG3_IDE_TIMEOUT 10000000
+
+static volatile uint8_t *ibookg3_ide_reg(int minor, int reg)
+{
+  uintptr_t base = ibookg3_ata_base[minor];
+
+  if (reg == IDE_REGISTER_DEVICE_CONTROL_OFFSET) {
+    return (volatile uint8_t *) (base + KEYLARGO_DEVICE_CONTROL);
+  }
+
+  return (volatile uint8_t *) (base + KEYLARGO_REG(reg));
+}
+
+/* Read a taskfile register. Index 0 is the data word. */
+static void ibookg3_ide_ctrl_reg_read(int minor, int reg, uint16_t *value)
+{
+  if (reg == IDE_REGISTER_DATA || reg == IDE_REGISTER_DATA_WORD) {
+    *value = in_be16((volatile uint16_t *) ibookg3_ide_reg(minor, reg));
+    return;
+  }
+
+  if (reg == IDE_REGISTER_DATA_BYTE) {
+    reg = IDE_REGISTER_DATA;
+  }
+
+  *value = in_8(ibookg3_ide_reg(minor, reg));
+}
+
+static void ibookg3_ide_ctrl_reg_write(int minor, int reg, uint16_t value)
+{
+  if (reg == IDE_REGISTER_DATA || reg == IDE_REGISTER_DATA_WORD) {
+    out_be16((volatile uint16_t *) ibookg3_ide_reg(minor, reg), value);
+    return;
+  }
+
+  if (reg == IDE_REGISTER_DATA_BYTE) {
+    reg = IDE_REGISTER_DATA;
+  }
+
+  out_8(ibookg3_ide_reg(minor, reg), (uint8_t) value);
+}
+
+/*
+ * The KeyLargo data register holds the whole sector in one go: poll
+ * DRQ once, then move the words. A transfer that ends without DRQ seen
+ * leaves the request layer to report the status register error.
+ */
+static void ibookg3_ide_read_block(
+  int                        minor,
+  uint32_t                   block_size,
+  rtems_blkdev_sg_buffer    *bufs,
+  uint32_t                  *cbuf,
+  uint32_t                  *pos
+)
+{
+  volatile uint16_t *data;
+  volatile uint8_t *status;
+  uint16_t *lbuf;
+  unsigned int retries;
+  uint32_t cnt;
+
+  status = ibookg3_ide_reg(minor, IDE_REGISTER_STATUS);
+  data = (volatile uint16_t *) ibookg3_ide_reg(minor, IDE_REGISTER_DATA);
+
+  cnt = 0;
+  while (cnt < block_size) {
+    retries = 0;
+    while (!(in_8(status) & IDE_REGISTER_STATUS_DRQ)) {
+      if (++retries > IBOOKG3_IDE_TIMEOUT) {
+        printk(
+          "ide%d: read timed out with DRQ clear, status 0x%02x\n",
+          minor, in_8(status)
+        );
+        return;
+      }
+    }
+
+    lbuf = (uint16_t *)
+      ((uint8_t *) bufs[*cbuf].buffer + *pos);
+    for (int b = 0; b < ATA_SECTOR_SIZE / 2; ++b) {
+      *lbuf = in_be16(data);
+      ++lbuf;
+    }
+
+    cnt += ATA_SECTOR_SIZE;
+    *pos += ATA_SECTOR_SIZE;
+    if (*pos == bufs[*cbuf].length) {
+      *pos = 0;
+      ++(*cbuf);
+    }
+  }
+}
+
+static void ibookg3_ide_write_block(
+  int                        minor,
+  uint32_t                   block_size,
+  rtems_blkdev_sg_buffer    *bufs,
+  uint32_t                  *cbuf,
+  uint32_t                  *pos
+)
+{
+  volatile uint16_t *data;
+  volatile uint8_t *status;
+  uint16_t *lbuf;
+  unsigned int retries;
+  uint32_t cnt;
+
+  status = ibookg3_ide_reg(minor, IDE_REGISTER_STATUS);
+  data = (volatile uint16_t *) ibookg3_ide_reg(minor, IDE_REGISTER_DATA);
+
+  cnt = 0;
+  while (cnt < block_size) {
+    retries = 0;
+    while (!(in_8(status) & IDE_REGISTER_STATUS_DRQ)) {
+      if (++retries > IBOOKG3_IDE_TIMEOUT) {
+        printk(
+          "ide%d: write timed out with DRQ clear, status 0x%02x\n",
+          minor, in_8(status)
+        );
+        return;
+      }
+    }
+
+    lbuf = (uint16_t *)
+      ((uint8_t *) bufs[*cbuf].buffer + *pos);
+    for (int b = 0; b < ATA_SECTOR_SIZE / 2; ++b) {
+      out_be16(data, *lbuf);
+      ++lbuf;
+    }
+
+    cnt += ATA_SECTOR_SIZE;
+    *pos += ATA_SECTOR_SIZE;
+    if (*pos == bufs[*cbuf].length) {
+      *pos = 0;
+      ++(*cbuf);
+    }
+  }
+}
+
+/*
+ * Software reset through the device control register, then wait for the
+ * drive to signal ready. The reset clears the device select, matching
+ * what the shared layer assumes before it probes the units.
+ */
+static void ibookg3_ide_ctrl_initialize(int minor)
+{
+  volatile uint8_t *status;
+  unsigned int retries;
+
+  out_8(ibookg3_ide_reg(minor, IDE_REGISTER_DEVICE_CONTROL_OFFSET),
+        IDE_REGISTER_DEVICE_CONTROL_SRST);
+  for (int i = 0; i < 1000; ++i) {
+    /* The spec asks for at least 10 us of reset pulse */
+  }
+  out_8(ibookg3_ide_reg(minor, IDE_REGISTER_DEVICE_CONTROL_OFFSET),
+        IDE_REGISTER_DEVICE_CONTROL_nIEN);
+
+  status = ibookg3_ide_reg(minor, IDE_REGISTER_STATUS);
+  retries = 0;
+  while (in_8(status) & IDE_REGISTER_STATUS_BSY) {
+    if (++retries > IBOOKG3_IDE_TIMEOUT) {
+      printk("ide%d: software reset did not complete\n", minor);
+      return;
+    }
+  }
+}
+
+static bool ibookg3_ide_ctrl_probe(int minor)
+{
+  return ibookg3_ata_base[minor] != 0;
+}
+
+/*
+ * The shared layer asks the BSP to program transfer timings. The
+ * KeyLargo timing register would need the per-cell values of the
+ * current UniNorth timing set, and QEMU ignores it, so the driver
+ * stays in the firmware's PIO mode and accepts anything the drive
+ * offers that is PIO.
+ */
+static rtems_status_code ibookg3_ide_ctrl_config_io_speed(
+  int      minor,
+  uint16_t modes_available
+)
+{
+  if ((modes_available & ATA_MODES_PIO) == 0) {
+    return RTEMS_NOT_DEFINED;
+  }
+
+  return RTEMS_SUCCESSFUL;
+}
+
+static int ibookg3_ide_ctrl_control(
+  int      minor,
+  uint32_t command,
+  void    *arg
+)
+{
+  return RTEMS_UNSATISFIED;
+}
+
+static ide_ctrl_fns_t ibookg3_ide_ctrl_fns = {
+  .ctrl_probe = ibookg3_ide_ctrl_probe,
+  .ctrl_initialize = ibookg3_ide_ctrl_initialize,
+  .ctrl_control = ibookg3_ide_ctrl_control,
+  .ctrl_reg_read = ibookg3_ide_ctrl_reg_read,
+  .ctrl_reg_write = ibookg3_ide_ctrl_reg_write,
+  .ctrl_read_block = ibookg3_ide_read_block,
+  .ctrl_write_block = ibookg3_ide_write_block,
+  .ctrl_config_io_speed = ibookg3_ide_ctrl_config_io_speed
+};
+
+ide_controller_bsp_table_t IDE_Controller_Table[IBOOKG3_ATA_COUNT] = {
+  {
+    .name = "/dev/ide0",
+    .type = IDE_STD,
+    .fns = &ibookg3_ide_ctrl_fns,
+    .probe = NULL,
+    .status = FALSE,
+    .port1 = 0,
+    .int_driven = FALSE,
+    .int_vec = 0,
+    .params = NULL
+  }, {
+    .name = "/dev/ide1",
+    .type = IDE_STD,
+    .fns = &ibookg3_ide_ctrl_fns,
+    .probe = NULL,
+    .status = FALSE,
+    .port1 = 0,
+    .int_driven = FALSE,
+    .int_vec = 0,
+    .params = NULL
+  }
+};
+
+unsigned long IDE_Controller_Count = IBOOKG3_ATA_COUNT;
