+ * AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
+ * IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
+ * ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE
+ * LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+ * POSSIBILITY OF SUCH DAMAGE.
+ */
+
+/*
+ * The shared PowerPC OpenPIC driver (openpic.c) does the low-level controller
+ * setup. This file provides the dispatch and the generic interrupt
+ * controller API on top of it.
+ *
+ * Vectors 0 to 63 are the OpenPIC sources, followed by the four OpenPIC
+ * inter-processor interrupts which this processor sends to itself (software
+ * interrupts that can be raised). The decrementer has its own vector; it is
+ * always enabled at the controller level.
+ */
+
+#include <bsp.h>
+#include <bsp/fatal.h>
+#include <bsp/irq-generic.h>
+#include <bsp/irq.h>
+#include <bsp/openpic.h>
+#include <bsp/vectors.h>
+#include <libcpu/io.h>
+
+/* OpenPIC priority 0 masks a source; RTEMS priority = 15 - OpenPIC priority */
+#define IBOOKG3_PIC_PRIORITY_MAX 15
+
+#define IBOOKG3_PIC_PRIORITY_DEFAULT 8
+
+static rtems_irq_connect_data ibookg3_irq_table[BSP_IRQ_NUMBER];
+
+static rtems_irq_prio ibookg3_irq_prio[BSP_IRQ_NUMBER];
+
+static rtems_irq_global_settings ibookg3_irq_config;
+
+static const rtems_irq_connect_data ibookg3_irq_default = {
+  .name = 0,
+  .hdl = NULL
+};
+
+RTEMS_STATIC_ASSERT(
+  IBOOKG3_IRQ_IPI_0 ==
+    OPENPIC_VEC_IPI - OPENPIC_VEC_SOURCE + BSP_PCI_IRQ_LOWEST_OFFSET,
+  ibookg3_irq_ipi_0
+);
+
+static bool is_pic_source(rtems_vector_number vector)
+{
+  return vector >= BSP_PCI_IRQ_LOWEST_OFFSET &&
+    vector <= BSP_PCI_IRQ_MAX_OFFSET;
+}
+
+static bool is_ipi(rtems_vector_number vector)
+{
+  return vector >= IBOOKG3_IRQ_IPI_0 &&
+    vector < IBOOKG3_IRQ_IPI_0 + IBOOKG3_IRQ_IPI_NUMBER;
+}
+
+static bool is_pic_vector(rtems_vector_number vector)
+{
+  return is_pic_source(vector) || is_ipi(vector);
+}
+
+/* Vector/priority register of a source or IPI */
+static volatile uint32_t *pic_vpr_reg(rtems_vector_number vector)
+{
+  if (is_ipi(vector)) {
+    return (volatile uint32_t *)
+      &OpenPIC->Global.IPI_Vector_Priority(vector - IBOOKG3_IRQ_IPI_0);
+  }
+
+  return (volatile uint32_t *)
+    &OpenPIC->Source[vector - BSP_PCI_IRQ_LOWEST_OFFSET].Vector_Priority;
+}
+
+static uint32_t pic_vpr(rtems_vector_number vector)
+{
+  return in_le32(pic_vpr_reg(vector));
+}
+
+static void pic_vpr_modify(
+  rtems_vector_number vector,
+  uint32_t            clear,
+  uint32_t            set
+)
+{
+  rtems_interrupt_level level;
+  volatile uint32_t *reg = pic_vpr_reg(vector);
+
+  rtems_interrupt_disable(level);
+  out_le32(reg, (in_le32(reg) & ~clear) | set);
+  rtems_interrupt_enable(level);
+}
+
+rtems_status_code bsp_interrupt_get_attributes(
+  rtems_vector_number         vector,
+  rtems_interrupt_attributes *attributes
+)
+{
+  bsp_interrupt_assert(bsp_interrupt_is_valid_vector(vector));
+
+  attributes->is_maskable = true;
+
+  if (is_pic_vector(vector)) {
+    attributes->can_raise = is_ipi(vector);
+    attributes->can_enable = true;
+    attributes->maybe_enable = true;
+    attributes->can_disable = true;
+    attributes->maybe_disable = true;
+    attributes->cleared_by_acknowledge = true;
+    attributes->can_get_priority = true;
+    attributes->can_set_priority = true;
+    attributes->maximum_priority = IBOOKG3_PIC_PRIORITY_MAX;
+  }
+
+  return RTEMS_SUCCESSFUL;
+}
+
+rtems_status_code bsp_interrupt_is_pending(
+  rtems_vector_number vector,
+  bool               *pending
+)
+{
+  bsp_interrupt_assert(bsp_interrupt_is_valid_vector(vector));
+  bsp_interrupt_assert(pending != NULL);
+
+  if (is_pic_vector(vector)) {
+    *pending = (pic_vpr(vector) & OPENPIC_ACTIVITY) != 0;
+  } else {
+    /* The processor has no readable decrementer exception status */
+    *pending = false;
+  }
+
+  return RTEMS_SUCCESSFUL;
+}
+
+rtems_status_code bsp_interrupt_raise(rtems_vector_number vector)
+{
+  bsp_interrupt_assert(bsp_interrupt_is_valid_vector(vector));
+
+  if (!is_ipi(vector)) {
+    return RTEMS_UNSATISFIED;
+  }
+
+  /* Send the IPI to this processor (processor 0) */
+  openpic_cause_IPI(0, vector - IBOOKG3_IRQ_IPI_0, 1);
+  return RTEMS_SUCCESSFUL;
+}
+
+rtems_status_code bsp_interrupt_clear(rtems_vector_number vector)
+{
+  bsp_interrupt_assert(bsp_interrupt_is_valid_vector(vector));
+  return RTEMS_UNSATISFIED;
+}
+
+rtems_status_code bsp_interrupt_vector_is_enabled(
+  rtems_vector_number vector,
+  bool               *enabled
+)
+{
+  bsp_interrupt_assert(bsp_interrupt_is_valid_vector(vector));
+  bsp_interrupt_assert(enabled != NULL);
+
+  if (is_pic_vector(vector)) {
+    *enabled = (pic_vpr(vector) & OPENPIC_MASK) == 0;
+  } else {
+    *enabled = true;
+  }
+
+  return RTEMS_SUCCESSFUL;
+}
+
+rtems_status_code bsp_interrupt_vector_enable(rtems_vector_number vector)
+{
+  bsp_interrupt_assert(bsp_interrupt_is_valid_vector(vector));
+
+  if (!is_pic_vector(vector)) {
+    return RTEMS_UNSATISFIED;
+  }
+
+  pic_vpr_modify(vector, OPENPIC_MASK, 0);
+  return RTEMS_SUCCESSFUL;
+}
+
+rtems_status_code bsp_interrupt_vector_disable(rtems_vector_number vector)
+{
+  bsp_interrupt_assert(bsp_interrupt_is_valid_vector(vector));
+
+  if (!is_pic_vector(vector)) {
+    return RTEMS_UNSATISFIED;
+  }
+
+  pic_vpr_modify(vector, 0, OPENPIC_MASK);
+  return RTEMS_SUCCESSFUL;
+}
+
+rtems_status_code bsp_interrupt_set_priority(
+  rtems_vector_number vector,
+  uint32_t            priority
+)
+{
+  bsp_interrupt_assert(bsp_interrupt_is_valid_vector(vector));
+
+  if (!is_pic_vector(vector)) {
+    return RTEMS_UNSATISFIED;
+  }
+
+  if (priority > IBOOKG3_PIC_PRIORITY_MAX) {
+    return RTEMS_INVALID_PRIORITY;
+  }
+
+  pic_vpr_modify(
+    vector,
+    OPENPIC_PRIORITY_MASK,
+    (IBOOKG3_PIC_PRIORITY_MAX - priority) << OPENPIC_PRIORITY_SHIFT
+  );
+  return RTEMS_SUCCESSFUL;
+}
+
+rtems_status_code bsp_interrupt_get_priority(
+  rtems_vector_number vector,
+  uint32_t           *priority
+)
+{
+  bsp_interrupt_assert(bsp_interrupt_is_valid_vector(vector));
+  bsp_interrupt_assert(priority != NULL);
+
+  if (!is_pic_vector(vector)) {
+    return RTEMS_UNSATISFIED;
+  }
+
+  *priority = IBOOKG3_PIC_PRIORITY_MAX -
+    ((pic_vpr(vector) & OPENPIC_PRIORITY_MASK) >> OPENPIC_PRIORITY_SHIFT);
+  return RTEMS_SUCCESSFUL;
+}
+
+/*
+ * Handler for the external and decrementer exceptions. The dispatch itself
+ * is in irq-dispatch.c, a separate file, so that tests can wrap
+ * bsp_interrupt_dispatch() at link time.
+ */
+static int ibookg3_exception_dispatch(
+  BSP_Exception_frame *frame,
+  unsigned int         exception_number
+)
+{
+  (void) frame;
+
+  bsp_interrupt_dispatch(exception_number);
+  return 0;
+}
+
+void bsp_interrupt_facility_initialize(void)
+{
+  rtems_status_code sc;
+  int i;
+
+  OpenPIC = (void *) (ibookg3_macio_base + IBOOKG3_MACIO_OPENPIC);
+  openpic_init(1, NULL, NULL, BSP_PCI_IRQ_NUMBER, 0, 0);
+
+  for (i = 0; i < BSP_IRQ_NUMBER; ++i) {
+    ibookg3_irq_table[i] = ibookg3_irq_default;
+    ibookg3_irq_table[i].name = i;
+  }
+
+  for (i = BSP_PCI_IRQ_LOWEST_OFFSET; i <= BSP_PCI_IRQ_MAX_OFFSET; ++i) {
+    ibookg3_irq_prio[i] = IBOOKG3_PIC_PRIORITY_DEFAULT;
+  }
+
+  ibookg3_irq_config.irqNb = BSP_IRQ_NUMBER;
+  ibookg3_irq_config.defaultEntry = ibookg3_irq_default;
+  ibookg3_irq_config.irqHdlTbl = ibookg3_irq_table;
+  ibookg3_irq_config.irqBase = BSP_LOWEST_OFFSET;
+  ibookg3_irq_config.irqPrioTbl = ibookg3_irq_prio;
+
+  if (!BSP_setup_the_pic(&ibookg3_irq_config)) {
+    bsp_fatal(BSP_FATAL_INTERRUPT_INITIALIZATION);
+  }
+
+  /* IPIs: masked until enabled, priority 1 higher for each one */
+  for (i = 0; i < IBOOKG3_IRQ_IPI_NUMBER; ++i) {
+    openpic_initipi(i, IBOOKG3_PIC_PRIORITY_DEFAULT + i, OPENPIC_VEC_IPI + i);
+    pic_vpr_modify(IBOOKG3_IRQ_IPI_0 + i, 0, OPENPIC_MASK);
+  }
+
+  sc = ppc_exc_set_handler(ASM_EXT_VECTOR, ibookg3_exception_dispatch);
+  _Assert_Unused_variable_equals(sc, RTEMS_SUCCESSFUL);
+
+  sc = ppc_exc_set_handler(ASM_DEC_VECTOR, ibookg3_exception_dispatch);
+  _Assert_Unused_variable_equals(sc, RTEMS_SUCCESSFUL);
+
+}
diff --git a/bsps/powerpc/ibookg3/start/bspstart.c b/bsps/powerpc/ibookg3/start/bspstart.c
new file mode 100644
index 00000000000..b2458736b4b
--- /dev/null
+++ b/bsps/powerpc/ibookg3/start/bspstart.c
@@ -0,0 +1,126 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+
+/**
+ * @file
+ *
+ * @ingroup RTEMSBSPsPowerPCiBookG3
+ *
+ * @brief BSP startup.
+ */
+
+/*
+ * Copyright (C) 2026 Erik Gonzalez
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
+ * 1. Redistributions of source code must retain the above copyright
+ *    notice, this list of conditions and the following disclaimer.
+ * 2. Redistributions in binary form must reproduce the above copyright
+ *    notice, this list of conditions and the following disclaimer in the
+ *    documentation and/or other materials provided with the distribution.
+ *
+ * THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS "AS IS"
+ * AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
+ * IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
+ * ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE
+ * LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+ * POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include <bsp.h>
+#include <bsp/bootcard.h>
+#include <bsp/irq.h>
+#include <bsp/irq-generic.h>
+#include <bsp/linker-symbols.h>
+#include <rtems/bspIo.h>
+#include <rtems/counter.h>
+#include <rtems/error.h>
+#include <rtems/powerpc/powerpc.h>
+
+#include <libcpu/bat.h>
+#include <libcpu/cpuIdent.h>
+#include <libcpu/spr.h>
+
+/* Used by the shared decrementer clock driver: ticks per ms = bus/divisor */
+unsigned int BSP_bus_frequency;
+unsigned int BSP_time_base_divisor;
+
+uint32_t bsp_clicks_per_usec;
+
+uint32_t _CPU_Counter_frequency(void)
+{
+  return ibookg3_timebase_frequency;
+}
+
+/* BAT size: smallest power of two from 128 KiB to 256 MiB covering size */
+static uint32_t bat_size(uint32_t size)
+{
+  uint32_t bat = 128 * 1024;
+
+  while (bat < size && bat < 256 * 1024 * 1024) {
+    bat <<= 1;
+  }
+
+  return bat;
+}
+
+void bsp_start(void)
+{
+  uintptr_t ram_end = ibookg3_memory_size;
+  uintptr_t image_end = (uintptr_t) bsp_section_work_begin;
+  uintptr_t io = ibookg3_macio_base & 0xf0000000;
+
+  if (ram_end == 0) {
+    ram_end = IBOOKG3_MEMORY_SIZE_DEFAULT;
+  }
+
+  get_ppc_cpu_type();
+
+  BSP_bus_frequency = ibookg3_timebase_frequency;
+  BSP_time_base_divisor = 1000;
+  bsp_clicks_per_usec = ibookg3_timebase_frequency / 1000000;
+
+  /*
+   * RAM cached; KeyLargo and the rest of the PCI space uncached, guarded.
+   * Translation is on before the exceptions are initialized, so that the
+   * exception handlers run with it too and see the I/O space uncached.
+   */
+  setdbat(0, 0, 0, bat_size(ram_end), _PAGE_RW);
+  setibat(0, 0, 0, bat_size(ram_end), 0);
+  setdbat(1, io, io, 256 * 1024 * 1024, IO_PAGE);
+
+  _write_MSR(_read_MSR() | MSR_DR | MSR_IR);
+  __asm__ volatile("sync; isync");
+
+  /* Vectors at 0 (MSR[IP] = 0), replacing those of Open Firmware */
+  ppc_exc_initialize_with_vector_base(
+    (uintptr_t) _ISR_Stack_area_begin,
+    NULL
+  );
+
+  bsp_interrupt_initialize();
+
+  if (ram_end < image_end) {
+    rtems_panic(
+      "iBook G3: %lu MiB RAM is less than the image end at 0x%08lx\n",
+      (unsigned long) (ram_end / (1024 * 1024)),
+      (unsigned long) image_end
+    );
+  }
+
+  printk(
+    "iBook G3: CPU %lu MHz, bus %lu MHz, timebase %lu Hz, RAM %lu MiB,"
+    " mac-io 0x%08lx\n",
+    (unsigned long) (ibookg3_cpu_frequency / 1000000),
+    (unsigned long) (ibookg3_bus_frequency / 1000000),
+    (unsigned long) ibookg3_timebase_frequency,
+    (unsigned long) (ibookg3_memory_size / (1024 * 1024)),
+    (unsigned long) ibookg3_macio_base
+  );
+}
diff --git a/bsps/powerpc/ibookg3/start/linkcmds b/bsps/powerpc/ibookg3/start/linkcmds
new file mode 100644
index 00000000000..8afb8ab0282
--- /dev/null
+++ b/bsps/powerpc/ibookg3/start/linkcmds
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+
+/*
+ * Copyright (C) 2026 Erik Gonzalez
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
+ * 1. Redistributions of source code must retain the above copyright
+ *    notice, this list of conditions and the following disclaimer.
+ * 2. Redistributions in binary form must reproduce the above copyright
+ *    notice, this list of conditions and the following disclaimer in the
+ *    documentation and/or other materials provided with the distribution.
+ *
+ * THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS "AS IS"
+ * AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
+ * IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
+ * ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE
+ * LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+ * POSSIBILITY OF SUCH DAMAGE.
+ */
+
+/*
+ * The image runs at 16 MiB, above Open Firmware's low memory, and the
+ * exception vectors RTEMS installs at address zero. QEMU's mac99 loader
+ * places a segment at (physical address & 0x0fffffff) + 16 MiB and enters at
+ * 16 MiB, so the load addresses start at zero.
+ *
+ * The regions cover only the image (code, data, bss, interrupt stack). The
+ * work area from the end of the image to the end of RAM is set up at run
+ * time from the Open Firmware memory size (see memory.c), so that no loader
+ * has to clear all of RAM.
+ */
+
+EXTERN (_start)
+ENTRY (_start)
+
+MEMORY {
+	RAM       : ORIGIN = 0x01000000, LENGTH = 16M
+	LOAD      : ORIGIN = 0x00000000, LENGTH = 16M
+	EMPTY     : ORIGIN = 0x0, LENGTH = 0
+}
+
+REGION_ALIAS ("REGION_START", RAM);
+REGION_ALIAS ("REGION_FAST_TEXT", RAM);
+REGION_ALIAS ("REGION_FAST_TEXT_LOAD", LOAD);
+REGION_ALIAS ("REGION_TEXT", RAM);
+REGION_ALIAS ("REGION_TEXT_LOAD", LOAD);
+REGION_ALIAS ("REGION_RODATA", RAM);
+REGION_ALIAS ("REGION_RODATA_LOAD", LOAD);
+REGION_ALIAS ("REGION_FAST_DATA", RAM);
+REGION_ALIAS ("REGION_FAST_DATA_LOAD", LOAD);
+REGION_ALIAS ("REGION_DATA", RAM);
+REGION_ALIAS ("REGION_DATA_LOAD", LOAD);
+REGION_ALIAS ("REGION_BSS", RAM);
+REGION_ALIAS ("REGION_RTEMSSTACK", RAM);
+REGION_ALIAS ("REGION_WORK", RAM);
+REGION_ALIAS ("REGION_STACK", RAM);
+REGION_ALIAS ("REGION_NOCACHE", EMPTY);
+REGION_ALIAS ("REGION_NOCACHE_LOAD", EMPTY);
+REGION_ALIAS ("REGION_NVRAM", EMPTY);
+
+/*
+ * One segment for the whole image, so that the uninitialized sections are
+ * placed with the same offset as the rest and not 16 MiB too high.
+ */
+PHDRS {
+	image PT_LOAD;
+}
+
+/* The entry code must be the first byte loaded (see above) */
+SECTIONS {
+	.ibookg3_entry : {
+		KEEP (*(.ibookg3_entry))
+	} > RAM AT > LOAD :image
+}
+
+/* Allocate the maximum size to the small data area */
+bsp_section_small_data_area_size = 65536;
+
+INCLUDE linkcmds.base
diff --git a/bsps/powerpc/ibookg3/start/memory.c b/bsps/powerpc/ibookg3/start/memory.c
new file mode 100644
index 00000000000..6b674f89721
--- /dev/null
+++ b/bsps/powerpc/ibookg3/start/memory.c
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+
+/**
+ * @file
+ *
+ * @ingroup RTEMSBSPsPowerPCiBookG3
+ *
+ * @brief Work area from the end of the image to the end of RAM.
+ */
+
+/*
+ * Copyright (C) 2026 Erik Gonzalez
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
+ * 1. Redistributions of source code must retain the above copyright
+ *    notice, this list of conditions and the following disclaimer.
+ * 2. Redistributions in binary form must reproduce the above copyright
+ *    notice, this list of conditions and the following disclaimer in the
+ *    documentation and/or other materials provided with the distribution.
+ *
+ * THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS "AS IS"
+ * AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
+ * IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
+ * ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE
+ * LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+ * POSSIBILITY OF SUCH DAMAGE.
+ */
+
+/*
+ * The linker regions only cover the loaded image, so that a boot loader does
+ * not have to clear all of RAM. The RAM size comes from Open Firmware.
+ */
+
+#include <bsp.h>
+#include <bsp/bootcard.h>
+#include <bsp/linker-symbols.h>
+
+#include <rtems/sysinit.h>
+
+static Memory_Area _Memory_Areas[1];
+
+static void bsp_memory_initialize(void)
+{
+  uintptr_t begin = (uintptr_t) bsp_section_work_begin;
+  uintptr_t end = ibookg3_memory_size;
+
+  if (end == 0) {
+    end = IBOOKG3_MEMORY_SIZE_DEFAULT;
+  }
+
+  _Memory_Initialize(&_Memory_Areas[0], (void *) begin, (void *) end);
+}
+
+RTEMS_SYSINIT_ITEM(
+  bsp_memory_initialize,
+  RTEMS_SYSINIT_MEMORY,
+  RTEMS_SYSINIT_ORDER_MIDDLE
+);
+
+static const Memory_Information _Memory_Information =
+  MEMORY_INFORMATION_INITIALIZER(_Memory_Areas);
+
+const Memory_Information *_Memory_Get(void)
+{
+  return &_Memory_Information;
+}
