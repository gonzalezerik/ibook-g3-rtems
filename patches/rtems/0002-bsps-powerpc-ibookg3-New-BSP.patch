@@ -0,0 +1,193 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+
+/**
+ * @file
+ *
+ * @ingroup RTEMSBSPsPowerPCiBookG3
+ *
+ * @brief Reads the machine description from the Open Firmware device tree.
+ */
+
+/*
+ * Copyright (C) 2026 Erik Gonzalez
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
+ * 1. Redistributions of source code must retain the above copyright
+ *    notice, this list of conditions and the following disclaimer.
+ * 2. Redistributions in binary form must reproduce the above copyright
+ *    notice, this list of conditions and the following disclaimer in the
+ *    documentation and/or other materials provided with the distribution.
+ *
+ * THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS "AS IS"
+ * AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
+ * IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
+ * ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE
+ * LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+ * POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include <bsp.h>
+
+#include <string.h>
+
+/*
+ * Values the rest of the BSP uses. The defaults match QEMU's mac99 machine
+ * and are kept if a property is missing.
+ */
+uint32_t ibookg3_timebase_frequency = 25000000;
+uint32_t ibookg3_bus_frequency = 100000000;
+uint32_t ibookg3_cpu_frequency = 900000000;
+uint32_t ibookg3_memory_size;
+uintptr_t ibookg3_macio_base = IBOOKG3_MACIO_BASE_DEFAULT;
+
+typedef int32_t phandle;
+
+typedef int (*ofw_entry_fn)(void *args);
+
+static ofw_entry_fn ofw;
+
+/* IEEE 1275 client interface argument block */
+struct ofw_args {
+  const char *service;
+  int32_t nargs;
+  int32_t nret;
+  uint32_t args[6];
+};
+
+static int32_t ofw_call(
+  const char *service,
+  int nargs,
+  int nret,
+  uint32_t a0,
+  uint32_t a1,
+  uint32_t a2,
+  uint32_t a3
+)
+{
+  struct ofw_args a = {
+    .service = service,
+    .nargs = nargs,
+    .nret = nret,
+    .args = { a0, a1, a2, a3, 0, 0 }
+  };
+
+  if ((*ofw)(&a) != 0) {
+    return -1;
+  }
+
+  return (int32_t) a.args[nargs];
+}
+
+static phandle ofw_finddevice(const char *path)
+{
+  return ofw_call("finddevice", 1, 1, (uintptr_t) path, 0, 0, 0);
+}
+
+static phandle ofw_child(phandle node)
+{
+  return ofw_call("child", 1, 1, (uint32_t) node, 0, 0, 0);
+}
+
+static phandle ofw_peer(phandle node)
+{
+  return ofw_call("peer", 1, 1, (uint32_t) node, 0, 0, 0);
+}
+
+static int32_t ofw_getprop(
+  phandle node,
+  const char *name,
+  void *buf,
+  uint32_t len
+)
+{
+  return ofw_call(
+    "getprop",
+    4,
+    1,
+    (uint32_t) node,
+    (uintptr_t) name,
+    (uintptr_t) buf,
+    len
+  );
+}
+
+static void ofw_get_u32(phandle node, const char *name, uint32_t *value)
+{
+  uint32_t v;
+
+  if (ofw_getprop(node, name, &v, sizeof(v)) == (int32_t) sizeof(v)) {
+    *value = v;
+  }
+}
+
+/* Depth-first search for the first node with the given name */
+static phandle ofw_find_by_name(phandle node, const char *name)
+{
+  while (node != 0 && node != -1) {
+    char buf[32];
+    int32_t len = ofw_getprop(node, "name", buf, sizeof(buf) - 1);
+    phandle found;
+
+    if (len > 0) {
+      buf[len] = '\0';
+      if (strcmp(buf, name) == 0) {
+        return node;
+      }
+    }
+
+    found = ofw_find_by_name(ofw_child(node), name);
+    if (found != 0 && found != -1) {
+      return found;
+    }
+
+    node = ofw_peer(node);
+  }
+
+  return 0;
+}
+
+void ibookg3_ofw_probe(void *ofw_entry)
+{
+  phandle node;
+  uint32_t reg[16];
+  int32_t len;
+
+  ofw = (ofw_entry_fn) ofw_entry;
+
+  node = ofw_finddevice("/cpus");
+  if (node != -1) {
+    node = ofw_child(node);
+    if (node != 0 && node != -1) {
+      ofw_get_u32(node, "timebase-frequency", &ibookg3_timebase_frequency);
+      ofw_get_u32(node, "bus-frequency", &ibookg3_bus_frequency);
+      ofw_get_u32(node, "clock-frequency", &ibookg3_cpu_frequency);
+    }
+  }
+
+  /* RAM contiguous from address zero; reg is a list of (base, size) */
+  node = ofw_finddevice("/memory");
+  if (node != -1) {
+    len = ofw_getprop(node, "reg", reg, sizeof(reg));
+    for (int32_t i = 0; i + 1 < len / 4; i += 2) {
+      if (reg[i] == ibookg3_memory_size) {
+        ibookg3_memory_size += reg[i + 1];
+      }
+    }
+  }
+
+  /* assigned-addresses: phys.hi, phys.mid, phys.lo, size.hi, size.lo */
+  node = ofw_find_by_name(ofw_peer(0), "mac-io");
+  if (node != 0) {
+    len = ofw_getprop(node, "assigned-addresses", reg, sizeof(reg));
+    if (len >= 5 * 4) {
+      ibookg3_macio_base = reg[2];
+    }
+  }
+}
