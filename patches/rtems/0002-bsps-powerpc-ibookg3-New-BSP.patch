+ * LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+ * POSSIBILITY OF SUCH DAMAGE.
+ */
+
+/*
+ * The test interrupts are the two OpenPIC inter-processor interrupts which
+ * the processor sends to itself. The second one has the higher priority and
+ * is used for the nested interrupt.
+ */
+
+#ifndef _RTEMS_TMTEST27
+#error "This is an RTEMS internal file you must not include directly."
+#endif
+
+#ifndef __tm27_h
+#define __tm27_h
+
+#include <bsp.h>
+#include <bsp/irq-generic.h>
+#include <bsp/irq.h>
+
+#define MUST_WAIT_FOR_INTERRUPT 1
+
+#define TM27_INTERRUPT_VECTOR_DEFAULT IBOOKG3_IRQ_IPI_0
+
+#define TM27_INTERRUPT_VECTOR_NESTED IBOOKG3_IRQ_IPI_1
+
+extern uint32_t Interrupt_nest;
+
+static inline void Install_tm27_vector( rtems_interrupt_handler handler )
+{
+  static rtems_interrupt_entry entry_low;
+  static rtems_interrupt_entry entry_high;
+
+  rtems_interrupt_entry_initialize( &entry_low, handler, NULL, "tm27 low" );
+  (void) rtems_interrupt_entry_install(
+    TM27_INTERRUPT_VECTOR_DEFAULT,
+    RTEMS_INTERRUPT_SHARED,
+    &entry_low
+  );
+
+  rtems_interrupt_entry_initialize( &entry_high, handler, NULL, "tm27 high" );
+  (void) rtems_interrupt_entry_install(
+    TM27_INTERRUPT_VECTOR_NESTED,
+    RTEMS_INTERRUPT_SHARED,
+    &entry_high
+  );
+}
+
+static inline void Cause_tm27_intr( void )
+{
+  rtems_vector_number vector;
+
+  vector = TM27_INTERRUPT_VECTOR_DEFAULT + ( Interrupt_nest >> 1 );
+  (void) rtems_interrupt_raise( vector );
+}
+
+/* An IPI is cleared by the interrupt acknowledge */
+#define Clear_tm27_intr() do { } while ( 0 )
+
+#define Lower_tm27_intr() do { } while ( 0 )
+
+#endif /* __tm27_h */
diff --git a/bsps/powerpc/ibookg3/irq/irq-dispatch.c b/bsps/powerpc/ibookg3/irq/irq-dispatch.c
