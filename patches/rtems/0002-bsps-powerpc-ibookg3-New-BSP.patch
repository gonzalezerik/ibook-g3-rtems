+ * POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#ifndef LIBBSP_POWERPC_IRQ_H
+#define LIBBSP_POWERPC_IRQ_H
+
+#define BSP_SHARED_HANDLER_SUPPORT 1
+
+#define BSP_POWERPC_IRQ_GENERIC_SUPPORT 1
+
+#ifndef ASM
+
+#include <rtems/irq.h>
+
+/* KeyLargo's OpenPIC (MPIC) has 64 interrupt sources */
+#define BSP_PCI_IRQ_NUMBER 64
+#define BSP_PCI_IRQ_LOWEST_OFFSET 0
+#define BSP_PCI_IRQ_MAX_OFFSET \
+  (BSP_PCI_IRQ_LOWEST_OFFSET + BSP_PCI_IRQ_NUMBER - 1)
+
+/*
+ * OpenPIC inter-processor interrupts sent to this processor serve as
+ * software interrupts. Their vectors follow the sources, which is how the
+ * shared OpenPIC dispatcher numbers them.
+ */
+#define IBOOKG3_IRQ_IPI_NUMBER 4
+#define IBOOKG3_IRQ_IPI_0 (BSP_PCI_IRQ_MAX_OFFSET + 1)
+#define IBOOKG3_IRQ_IPI_1 (IBOOKG3_IRQ_IPI_0 + 1)
+#define IBOOKG3_IRQ_IPI_2 (IBOOKG3_IRQ_IPI_0 + 2)
+#define IBOOKG3_IRQ_IPI_3 (IBOOKG3_IRQ_IPI_0 + 3)
+
+#define BSP_PROCESSOR_IRQ_NUMBER 1
+#define BSP_PROCESSOR_IRQ_LOWEST_OFFSET \
+  (IBOOKG3_IRQ_IPI_0 + IBOOKG3_IRQ_IPI_NUMBER)
+#define BSP_PROCESSOR_IRQ_MAX_OFFSET \
+  (BSP_PROCESSOR_IRQ_LOWEST_OFFSET + BSP_PROCESSOR_IRQ_NUMBER - 1)
+
+#define BSP_IRQ_NUMBER (BSP_PROCESSOR_IRQ_MAX_OFFSET + 1)
+#define BSP_LOWEST_OFFSET BSP_PCI_IRQ_LOWEST_OFFSET
+#define BSP_MAX_OFFSET (BSP_IRQ_NUMBER - 1)
+
+#define BSP_DECREMENTER BSP_PROCESSOR_IRQ_LOWEST_OFFSET
+
+#include <bsp/irq_supp.h>
+
+#define BSP_INTERRUPT_VECTOR_COUNT BSP_IRQ_NUMBER
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Dispatches the external and decrementer exceptions */
+void bsp_interrupt_dispatch(uintptr_t exception_number);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ASM */
+
+#endif /* LIBBSP_POWERPC_IRQ_H */
