+
+#
+# The Leon 3 QEMU BSP
+#
+#
+# The Apple iBook G3 BSP on QEMU's mac99 machine with a PowerPC 750CX and
+# 128 MiB of RAM. The console is the first serial port (ESCC channel A).
+#
+[ibookg3-qemu]
+bsp           = ibookg3
+arch          = powerpc
+tester        = %{_rtscripts}/qemu.cfg
+bsp_qemu_cmd  = qemu-system-ppc
+bsp_qemu_opts = %{qemu_opts_base} -monitor none -serial stdio %{qemu_opts_no_net} -M mac99 -cpu 750cx -m 128
diff --git a/tester/rtems/testing/qemu.cfg b/tester/rtems/testing/qemu.cfg
index 1b7d4aa..a514866 100644
--- a/tester/rtems/testing/qemu.cfg
+++ b/tester/rtems/testing/qemu.cfg
@@ -85,7 +85,11 @@
  %define bsp_qemu_image_path %{test_executable}
 %endif
 
-%define qemu_cmd  qemu-system-%{bsp_arch}
+%ifn %{defined bsp_qemu_cmd}
+ %define bsp_qemu_cmd qemu-system-%{bsp_arch}
+%endif
+
+%define qemu_cmd  %{bsp_qemu_cmd}
 %define qemu_opts %{bsp_qemu_opts} %{bsp_qemu_cov_opts}
 
